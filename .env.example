# Aura Music Academy — Firebase Client Configuration
# Copy this file to .env.local and fill in your Firebase project's web app config.
#
# SECURITY NOTE:
# These client variables identify your Firebase project to the browser SDK.
# Public Firebase client configuration is NOT a secret and is NOT a substitute
# for Firestore Security Rules. All data access control is enforced by
# firebase/firestore.rules on the server.
# NEVER put Firebase Admin SDK service-account keys or private secrets in .env or frontend code.
#
# If these variables are omitted, Aura Music Academy automatically runs in
# "Local Studio Mode" (graceful offline/localStorage fallback for auth, progress,
# bookmarks, quiz attempts, and local CMS previews) so learners and developers
# can use all lessons and interactive Web Audio labs without mandatory cloud setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false
